# Copy to .env for local runs. On GitHub, add these as repository secrets instead.
# Claude: use ONE of these. The first uses your Pro/Max plan (run: claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
IG_USER_ID=
IG_ACCESS_TOKEN=
# Optional: stock video behind the hook (free key from pexels.com/api)
PEXELS_API_KEY=
# Optional: better voice
ELEVENLABS_API_KEY=
# Optional: Graph API version
GRAPH_VERSION=v25.0
# Optional: natural Indian voices, free tier (portal.azure.com > Speech > F0)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Optional: Voicemaker.in voices
VOICEMAKER_API_KEY=
